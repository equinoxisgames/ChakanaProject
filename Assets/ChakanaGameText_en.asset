    m_Metadata:
      m_Items: []
  - m_Id: 2933982798192640
    m_Localized: MAIN MENU
    m_Metadata:
      m_Items: []
  - m_Id: 2935286438207488
    m_Localized: MAP
    m_Metadata:
      m_Items: []
  - m_Id: 2935320596619264
    m_Localized: ITEMS
    m_Metadata:
